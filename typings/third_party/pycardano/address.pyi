from .hash import ScriptHash, VerificationKeyHash
from .network import Network
from .serialization import CBORSerializable

class PointerAddress(CBORSerializable):
    def __init__(self, slot: int, tx_index: int, cert_index: int) -> None: ...
    @property
    def slot(self) -> int: ...
    @property
    def tx_index(self) -> int: ...
    @property
    def cert_index(self) -> int: ...

class Address(CBORSerializable):
    def __init__(
        self,
        payment_part: VerificationKeyHash | ScriptHash | None = ...,
        staking_part: VerificationKeyHash | ScriptHash | PointerAddress | None = ...,
        network: Network = ...,
    ) -> None: ...
    @property
    def is_byron(self) -> bool: ...
    @property
    def payment_part(self) -> VerificationKeyHash | ScriptHash | None: ...
    @property
    def staking_part(
        self,
    ) -> VerificationKeyHash | ScriptHash | PointerAddress | None: ...
    @property
    def network(self) -> Network: ...
    @property
    def hrp(self) -> str | None: ...
    def encode(self) -> str: ...
    @classmethod
    def decode(cls, data: str) -> Address: ...
    def to_primitive(self) -> bytes: ...
    @classmethod
    def from_primitive(cls, value: object) -> Address: ...
    def __bytes__(self) -> bytes: ...
    def __eq__(self, other: object) -> bool: ...
    def __hash__(self) -> int: ...
    @classmethod
    def load(cls, path: str) -> Address: ...
    def save(self, path: str, encoding: str | None = ...) -> None: ...
