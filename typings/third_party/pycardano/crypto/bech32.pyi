"""Typed surface of pycardano's vendored BIP-173 reference implementation
(reference types per the BIP-173 spec; the Encoding enum from pycardano)."""

from typing import Optional

class Encoding:
    BECH32: Encoding
    BECH32M: Encoding
    def __init__(self, name: str, checksum_constant: int) -> None: ...

def bech32_decode(bech: str) -> tuple[Optional[str], Optional[list[int]], Optional[Encoding]]: ...
def bech32_encode(hrp: str, data: list[int], spec: Encoding) -> str: ...
def bech32_verify_checksum(hrp: str, data: list[int]) -> Optional[Encoding]: ...
def convertbits(data: list[int], frombits: int, tobits: int, pad: bool) -> Optional[list[int]]: ...
