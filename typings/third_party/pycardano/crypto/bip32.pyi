class HDWallet:
    chain_code: bytes
    @classmethod
    def from_mnemonic(cls, mnemonic: str, passphrase: str = ...) -> HDWallet: ...
    @classmethod
    def from_entropy(cls, entropy: bytes, passphrase: str = ...) -> HDWallet: ...
    @classmethod
    def from_seed(cls, seed: bytes) -> HDWallet: ...
    @classmethod
    def generate_mnemonic(cls, strength: int = ...) -> str: ...
    @staticmethod
    def is_mnemonic(value: str) -> bool: ...
    @staticmethod
    def is_entropy(value: bytes) -> bool: ...
    def derive(self, absolute_path: str | list[int]) -> HDWallet: ...
    def derive_from_path(self, path: str) -> HDWallet: ...
    @property
    def xprivate_key(self) -> bytes: ...
    @property
    def private_key(self) -> bytes: ...
    @property
    def public_key(self) -> bytes: ...
    @property
    def root_public_key(self) -> bytes: ...
    @property
    def root_chain_code(self) -> bytes: ...
    @property
    def root_xprivate_key(self) -> bytes: ...
