from typing import Type, TypeVar

_H = TypeVar("_H", bound="_Hash")

class _Hash:
    MAX_SIZE: int
    MIN_SIZE: int
    payload: bytes
    def __init__(self, payload: bytes) -> None: ...
    @classmethod
    def from_primitive(cls: Type[_H], value: bytes | str) -> _H: ...
    @classmethod
    def from_cbor(cls: Type[_H], payload: str | bytes) -> _H: ...
    def to_primitive(self) -> bytes: ...
    def to_cbor(self) -> bytes: ...
    def to_cbor_hex(self) -> str: ...
    def __eq__(self, other: object) -> bool: ...
    def __hash__(self) -> int: ...
    def __bytes__(self) -> bytes: ...

class ScriptHash(_Hash): ...
class PolicyId(ScriptHash): ...
class DatumHash(_Hash): ...
class VerificationKeyHash(_Hash): ...
class AuxiliaryDataHash(_Hash): ...
class ScriptDataHash(_Hash): ...
class TransactionId(_Hash): ...
