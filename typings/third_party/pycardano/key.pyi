from typing import ClassVar, Optional, Self, Type, TypeVar

from .crypto.bip32 import HDWallet
from .hash import VerificationKeyHash
from .serialization import CBORSerializable

_K = TypeVar("_K", bound="Key")

class Key(CBORSerializable):
    KEY_TYPE: ClassVar[str]
    DESCRIPTION: ClassVar[str]
    payload: bytes
    key_type: str
    description: str
    def __init__(
        self,
        payload: bytes,
        key_type: Optional[str] = ...,
        description: Optional[str] = ...,
    ) -> None: ...
    @classmethod
    def from_json(cls: Type[_K], data: str, validate_type: bool = ...) -> _K: ...
    @classmethod
    def from_cbor(cls: Type[_K], payload: str | bytes) -> _K: ...
    def to_cbor_hex(self) -> str: ...
    def save(self, path: str) -> None: ...
    @classmethod
    def load(cls: Type[_K], path: str) -> _K: ...

class SigningKey(Key):
    @classmethod
    def generate(cls) -> SigningKey: ...
    def sign(self, data: bytes) -> bytes: ...
    def to_verification_key(self) -> VerificationKey: ...

class ExtendedSigningKey(Key):
    @classmethod
    def generate(cls) -> ExtendedSigningKey: ...
    def sign(self, data: bytes) -> bytes: ...
    def to_verification_key(self) -> ExtendedVerificationKey: ...
    # Runtime truth: from_hdwallet returns cls(...) — the subclass instance
    # (PaymentExtendedSigningKey.from_hdwallet IS a PaymentExtendedSigningKey).
    @classmethod
    def from_hdwallet(cls, hdwallet: HDWallet) -> Self: ...

class VerificationKey(Key):
    def hash(self) -> VerificationKeyHash: ...
    @classmethod
    def from_signing_key(cls, key: SigningKey) -> VerificationKey: ...

class ExtendedVerificationKey(VerificationKey):
    def hash(self) -> VerificationKeyHash: ...
    def to_non_extended(self) -> VerificationKey: ...
    @classmethod
    def from_signing_key(cls, key: SigningKey | ExtendedSigningKey) -> ExtendedVerificationKey: ...

class PaymentSigningKey(SigningKey): ...
class PaymentExtendedSigningKey(ExtendedSigningKey): ...
class StakeSigningKey(SigningKey): ...
class StakeExtendedSigningKey(ExtendedSigningKey): ...
class PaymentVerificationKey(VerificationKey): ...
class PaymentExtendedVerificationKey(ExtendedVerificationKey): ...
class StakeVerificationKey(VerificationKey): ...
class StakeExtendedVerificationKey(ExtendedVerificationKey): ...
