from typing import Type, TypeVar

_S = TypeVar("_S", bound="CBORSerializable")

class CBORSerializable:
    def to_shallow_primitive(self) -> object: ...
    def to_primitive(self) -> object: ...
    def validate(self) -> None: ...
    def to_validated_primitive(self) -> object: ...
    @classmethod
    def from_primitive(cls: Type[_S], value: object) -> _S: ...
    def to_cbor(self) -> bytes: ...
    def to_cbor_hex(self) -> str: ...
    @classmethod
    def from_cbor(cls: Type[_S], payload: str | bytes) -> _S: ...
    def to_json(self, **kwargs: object) -> str: ...
    @classmethod
    def from_json(cls: Type[_S], data: str) -> _S: ...

class IndefiniteList(list[object]): ...

class RawCBOR:
    cbor: bytes
    def __init__(self, cbor: bytes) -> None: ...
    def __eq__(self, other: object) -> bool: ...
    def __hash__(self) -> int: ...
